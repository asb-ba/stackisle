# ─────────────────────────────────────────────
# stackisle — Magento test stack configuration
# Copy to scripts/magento/magento.env (gitignored) and fill in the keys.
# Read by scripts/magento/magento.sh AFTER the main .env, so INSTALL_DIR,
# CERT_NAME, JAVA_* etc. still come from .env.
# Kept separate on purpose while testing; merges into .env on integration.
# ─────────────────────────────────────────────

# ── Domain (SSL through the shared aem-nginx on 443) ─────────────
MAGENTO_DOMAIN="dev-local-mc.brand.com"

# ── Composer / repo.magento.com access keys (REQUIRED) ────────────
# Create at https://commercemarketplace.adobe.com → My Profile → Access Keys.
# Public key = username, private key = password. Never commit these.
MAGENTO_PUBLIC_KEY=""
MAGENTO_PRIVATE_KEY=""

# ── Edition and version ──────────────────────────────────────────
# community  = Magento Open Source   (magento/project-community-edition)
# enterprise = Adobe Commerce        (magento/project-enterprise-edition — licensed keys only)
MAGENTO_EDITION="community"
# Leave empty for the latest release, or pin e.g. "2.4.8".
# Must match the PHP / MariaDB / OpenSearch versions below — check Adobe's
# "System requirements" page for the version you pin.
MAGENTO_VERSION="2.4.8"

# ── Service versions (verify against the Magento version's system requirements) ──
MAGENTO_PHP_VERSION="8.3"
MAGENTO_DB_IMAGE="mariadb:11.4"
MAGENTO_OPENSEARCH_IMAGE="opensearchproject/opensearch:2.19.1"
MAGENTO_REDIS_IMAGE="redis:7.2-alpine"
MAGENTO_WEB_IMAGE="nginx:1.27-alpine"
MAGENTO_COMPOSER_VERSION="2.8"
# OpenSearch JVM heap — 1g is enough for a dev catalogue
MAGENTO_OPENSEARCH_HEAP="1g"

# ── Database (container-internal only — not published on the host) ──
MAGENTO_DB_NAME="magento"
MAGENTO_DB_USER="magento"
MAGENTO_DB_PASSWORD="magento"
MAGENTO_DB_ROOT_PASSWORD="magento-root"

# ── Admin user ───────────────────────────────────────────────────
MAGENTO_ADMIN_USER="admin"
# Leave empty to generate one (saved to INSTALL_DIR/magento/admin-credentials.txt, mode 600)
MAGENTO_ADMIN_PASSWORD=""
MAGENTO_ADMIN_EMAIL="admin@example.com"
MAGENTO_ADMIN_FIRSTNAME="Admin"
MAGENTO_ADMIN_LASTNAME="Local"
MAGENTO_BACKEND_FRONTNAME="admin"     # admin at https://<domain>/admin

# ── Store defaults ───────────────────────────────────────────────
MAGENTO_LANGUAGE="en_US"
MAGENTO_CURRENCY="USD"
MAGENTO_TIMEZONE="UTC"

# ── Local dev conveniences ───────────────────────────────────────
# Disable admin 2FA (Magento_TwoFactorAuth) — local only, never in production
MAGENTO_DISABLE_2FA="1"
# developer | default | production
MAGENTO_MODE="developer"
